{
  "name": "quantlib",
  "description": "Library Management Tracker",
  "author": "Mentor High School",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "cross-env PKG_CONFIG_PATH=\"$PWD/src-tauri/.pkgconfig:/usr/lib64/pkgconfig\" LIBRARY_PATH=\"$PWD/src-tauri/.lib\" LD_LIBRARY_PATH=\"$PWD/src-tauri/.lib\" tauri",
    "tauri:dev": "npm run tauri -- dev",
    "tauri:build": "npm run tauri -- build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-icon": "node generate_icon.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "cross-env DATABASE_URL=file:./quantlib.db prisma db push",
    "seed": "cross-env DATABASE_URL=file:./quantlib.db node scripts/seed.js",
    "smoke": "cross-env DATABASE_URL=file:./quantlib.db node scripts/test-prisma.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "prisma": "^5.21.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
